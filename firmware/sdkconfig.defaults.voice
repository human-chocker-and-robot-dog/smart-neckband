# ESP32-C3 Voice infrastructure profile
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_voice.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_voice.csv"

# WakeNet, BLE, Wi-Fi, and TLS run concurrently on the single-core C3.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
