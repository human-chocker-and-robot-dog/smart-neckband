{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-neckband.local/contracts/health-mcp-v0.4.contract.json",
  "title": "Smart Collar Health MCP V0.4",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "WindowInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window_s": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300,
          "default": 30
        }
      }
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "0.4.0"},
        "generated_at": {"$ref": "#/$defs/Timestamp"},
        "wearer_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "window_s": {"type": "integer", "minimum": 10, "maximum": 300},
        "data_source": {
          "type": ["string", "null"],
          "enum": ["live", "replay", "synthetic", null]
        },
        "test_mode": {"type": ["boolean", "null"]},
        "source_instance_id": {
          "oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]
        },
        "latest_observed_at": {
          "oneOf": [{"$ref": "#/$defs/Timestamp"}, {"type": "null"}]
        },
        "age_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "trace_id": {"$ref": "#/$defs/Uuid"}
      },
      "required": [
        "schema_version", "generated_at", "wearer_id", "window_s",
        "data_source", "test_mode", "source_instance_id",
        "latest_observed_at", "age_ms", "trace_id"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "retryable": {"type": "boolean"},
        "retry_after_ms": {"type": ["integer", "null"], "minimum": 1},
        "details": {"type": "object"}
      },
      "required": ["code", "message", "retryable", "retry_after_ms", "details"]
    },
    "HeartRatePoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_at": {"$ref": "#/$defs/Timestamp"},
        "bpm": {"type": "number", "minimum": 20, "maximum": 240}
      },
      "required": ["observed_at", "bpm"]
    },
    "MotionPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_at": {"$ref": "#/$defs/Timestamp"},
        "score": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "required": ["observed_at", "score"]
    },
    "HeartRateData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid": {"type": "boolean"},
        "latest_bpm": {"type": ["number", "null"], "minimum": 20, "maximum": 240},
        "mean_bpm": {"type": ["number", "null"], "minimum": 20, "maximum": 240},
        "min_bpm": {"type": ["number", "null"], "minimum": 20, "maximum": 240},
        "max_bpm": {"type": ["number", "null"], "minimum": 20, "maximum": 240},
        "valid_sample_count": {"type": "integer", "minimum": 0},
        "total_sample_count": {"type": "integer", "minimum": 0},
        "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "signal_quality_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "lead_off_seen": {"type": "boolean"},
        "clipping_seen": {"type": "boolean"},
        "series": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/HeartRatePoint"}},
        "unavailable_reason": {"type": ["string", "null"]}
      },
      "required": [
        "valid", "latest_bpm", "mean_bpm", "min_bpm", "max_bpm",
        "valid_sample_count", "total_sample_count", "coverage_ratio",
        "signal_quality_mean", "lead_off_seen", "clipping_seen", "series",
        "unavailable_reason"
      ]
    },
    "HrvData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid": {"type": "boolean"},
        "estimate_type": {"const": "ultra_short_time_domain"},
        "rmssd_ms": {"type": ["number", "null"], "minimum": 0},
        "sdnn_ms": {"type": ["number", "null"], "minimum": 0},
        "pnn50_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "mean_nn_ms": {"type": ["number", "null"], "minimum": 300, "maximum": 2000},
        "valid_nn_count": {"type": "integer", "minimum": 0},
        "signal_quality_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "lead_off_seen": {"type": "boolean"},
        "clipping_seen": {"type": "boolean"},
        "unavailable_reason": {"type": ["string", "null"]}
      },
      "required": [
        "valid", "estimate_type", "rmssd_ms", "sdnn_ms",
        "pnn50_percent", "mean_nn_ms", "valid_nn_count",
        "signal_quality_mean", "lead_off_seen", "clipping_seen",
        "unavailable_reason"
      ]
    },
    "ImuStateData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid": {"type": "boolean"},
        "motion_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "still_ratio_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "level": {
          "type": ["string", "null"],
          "enum": ["still", "light", "moderate", "vigorous", null]
        },
        "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "imu_online": {"type": ["boolean", "null"]},
        "method": {"const": "mpu6050_accel_gyro_activity_v1"},
        "series": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/MotionPoint"}},
        "unavailable_reason": {"type": ["string", "null"]}
      },
      "required": [
        "valid", "motion_score", "still_ratio_percent", "level",
        "coverage_ratio", "imu_online", "method", "series",
        "unavailable_reason"
      ]
    },
    "SleepReportInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sleep_record_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "include_epochs": {"type": "boolean", "default": false},
        "epoch_offset": {"type": "integer", "minimum": 0, "default": 0},
        "epoch_limit": {"type": "integer", "minimum": 1, "maximum": 240, "default": 240}
      }
    },
    "SleepReportMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "0.4.0"},
        "generated_at": {"$ref": "#/$defs/Timestamp"},
        "wearer_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "trace_id": {"$ref": "#/$defs/Uuid"}
      },
      "required": ["schema_version", "generated_at", "wearer_id", "trace_id"]
    },
    "SleepStageValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "UNDEFINED": {"type": "number", "minimum": 0},
        "WAKE": {"type": "number", "minimum": 0},
        "REM": {"type": "number", "minimum": 0},
        "NREM": {"type": "number", "minimum": 0}
      },
      "required": ["UNDEFINED", "WAKE", "REM", "NREM"]
    },
    "SleepEpoch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch_index": {"type": "integer", "minimum": 0},
        "start_offset_s": {"type": "integer", "minimum": 0},
        "stage": {"enum": ["UNDEFINED", "WAKE", "REM", "NREM"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "probabilities": {"$ref": "#/$defs/SleepStageValues"},
        "reference_stage": {
          "type": ["string", "null"],
          "enum": ["UNDEFINED", "WAKE", "REM", "NREM", null]
        }
      },
      "required": [
        "epoch_index", "start_offset_s", "stage", "confidence",
        "probabilities", "reference_stage"
      ]
    },
    "SleepSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch_duration_s": {"type": "integer", "const": 30},
        "total_epoch_count": {"type": "integer", "minimum": 0},
        "valid_epoch_count": {"type": "integer", "minimum": 0},
        "analyzed_duration_s": {"type": "integer", "minimum": 0},
        "total_sleep_time_s": {"type": "integer", "minimum": 0},
        "sleep_efficiency_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "sleep_onset_latency_min": {"type": ["number", "null"], "minimum": 0},
        "wake_after_sleep_onset_min": {"type": ["number", "null"], "minimum": 0},
        "awakening_count": {"type": "integer", "minimum": 0},
        "stage_transition_count": {"type": "integer", "minimum": 0},
        "mean_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "stage_duration_s": {"$ref": "#/$defs/SleepStageValues"},
        "stage_percent": {"$ref": "#/$defs/SleepStageValues"}
      },
      "required": [
        "epoch_duration_s", "total_epoch_count", "valid_epoch_count",
        "analyzed_duration_s", "total_sleep_time_s",
        "sleep_efficiency_percent", "sleep_onset_latency_min",
        "wake_after_sleep_onset_min", "awakening_count",
        "stage_transition_count", "mean_confidence", "stage_duration_s",
        "stage_percent"
      ]
    },
    "SleepRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sleep_record_id": {"type": "string", "minLength": 1},
        "wearer_id": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "source_session_id": {"type": ["string", "null"]},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "display_name": {"type": "string", "minLength": 1},
        "source_name": {"type": "string", "minLength": 1},
        "lead_name": {"type": "string", "minLength": 1},
        "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "sample_count": {"type": "integer", "minimum": 1},
        "duration_s": {"type": "number", "minimum": 0},
        "recording_start_time": {"type": ["string", "null"]},
        "recording_end_time": {"type": ["string", "null"]},
        "demographics": {"type": "object"},
        "provenance": {"type": "object"},
        "imported_at": {"$ref": "#/$defs/Timestamp"}
      },
      "required": [
        "sleep_record_id", "wearer_id", "source_type", "source_session_id",
        "source_sha256", "display_name", "source_name", "lead_name",
        "sample_rate_hz", "sample_count", "duration_s",
        "recording_start_time", "recording_end_time", "demographics",
        "provenance", "imported_at"
      ]
    },
    "SleepAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysis_run_id": {"type": "string", "minLength": 1},
        "status": {"const": "completed"},
        "model_name": {"type": "string", "minLength": 1},
        "stages_mode": {"const": "wake-rem-nrem"},
        "sleepecg_version": {"type": "string", "minLength": 1},
        "tensorflow_version": {"type": "string", "minLength": 1},
        "heartbeat_count": {"type": "integer", "minimum": 0},
        "parameters": {"type": "object"},
        "summary": {"$ref": "#/$defs/SleepSummary"},
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "demographics_complete": {"type": "boolean"},
            "warnings": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["demographics_complete", "warnings"]
        },
        "started_at": {"$ref": "#/$defs/Timestamp"},
        "completed_at": {"$ref": "#/$defs/Timestamp"}
      },
      "required": [
        "analysis_run_id", "status", "model_name", "stages_mode",
        "sleepecg_version", "tensorflow_version", "heartbeat_count",
        "parameters", "summary", "quality", "started_at", "completed_at"
      ]
    },
    "SleepPagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1, "maximum": 240},
        "returned": {"type": "integer", "minimum": 0, "maximum": 240},
        "total": {"type": "integer", "minimum": 0},
        "next_offset": {"type": ["integer", "null"], "minimum": 0}
      },
      "required": ["offset", "limit", "returned", "total", "next_offset"]
    },
    "SleepReportData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record": {"$ref": "#/$defs/SleepRecord"},
        "analysis": {"$ref": "#/$defs/SleepAnalysis"},
        "epochs": {"type": "array", "maxItems": 240, "items": {"$ref": "#/$defs/SleepEpoch"}},
        "pagination": {"$ref": "#/$defs/SleepPagination"},
        "disclaimer": {"type": "string", "minLength": 1}
      },
      "required": ["record", "analysis", "epochs", "pagination", "disclaimer"]
    },
    "SleepReportEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": {"type": "boolean"},
        "data": {"oneOf": [{"$ref": "#/$defs/SleepReportData"}, {"type": "null"}]},
        "meta": {"$ref": "#/$defs/SleepReportMeta"},
        "error": {"oneOf": [{"$ref": "#/$defs/Error"}, {"type": "null"}]}
      },
      "required": ["ok", "data", "meta", "error"]
    },
    "HeartRateEnvelope": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ok": {"type": "boolean"},
        "data": {"oneOf": [{"$ref": "#/$defs/HeartRateData"}, {"type": "null"}]},
        "meta": {"$ref": "#/$defs/Meta"},
        "error": {"oneOf": [{"$ref": "#/$defs/Error"}, {"type": "null"}]}
      },
      "required": ["ok", "data", "meta", "error"]
    },
    "HrvEnvelope": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ok": {"type": "boolean"},
        "data": {"oneOf": [{"$ref": "#/$defs/HrvData"}, {"type": "null"}]},
        "meta": {"$ref": "#/$defs/Meta"},
        "error": {"oneOf": [{"$ref": "#/$defs/Error"}, {"type": "null"}]}
      },
      "required": ["ok", "data", "meta", "error"]
    },
    "ImuStateEnvelope": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ok": {"type": "boolean"},
        "data": {"oneOf": [{"$ref": "#/$defs/ImuStateData"}, {"type": "null"}]},
        "meta": {"$ref": "#/$defs/Meta"},
        "error": {"oneOf": [{"$ref": "#/$defs/Error"}, {"type": "null"}]}
      },
      "required": ["ok", "data", "meta", "error"]
    }
  },
  "x-contract": {
    "contract_version": "0.4.0",
    "mcp_protocol_version": "2025-11-25",
    "default_window_s": 30,
    "minimum_window_s": 10,
    "maximum_window_s": 300,
    "business_tool_count": 4
  },
  "x-mcp-tools": [
    {
      "name": "health.get_heart_rate",
      "title": "Get recent heart rate",
      "description": "Return bounded derived heart-rate statistics and trend points for the recent window. Does not return ECG samples or R peaks.",
      "inputSchema": {"$ref": "#/$defs/WindowInput"},
      "outputSchema": {"$ref": "#/$defs/HeartRateEnvelope"},
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false}
    },
    {
      "name": "health.get_hrv",
      "title": "Get recent HRV",
      "description": "Return an ultra-short time-domain HRV estimate from valid NN intervals in the recent window, with RMSSD as the primary rule metric.",
      "inputSchema": {"$ref": "#/$defs/WindowInput"},
      "outputSchema": {"$ref": "#/$defs/HrvEnvelope"},
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false}
    },
    {
      "name": "health.get_imu_state",
      "title": "Get recent IMU motion state",
      "description": "Return the local 0-100 motion score, still-time percentage, level, coverage, and bounded trend for the recent window.",
      "inputSchema": {"$ref": "#/$defs/WindowInput"},
      "outputSchema": {"$ref": "#/$defs/ImuStateEnvelope"},
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false}
    },
    {
      "name": "health.get_sleep_report",
      "title": "Get stored sleep ECG report",
      "description": "Return a completed local SleepECG WAKE/REM/NREM report and an optional bounded page of 30-second epochs. Never returns raw ECG samples.",
      "inputSchema": {"$ref": "#/$defs/SleepReportInput"},
      "outputSchema": {"$ref": "#/$defs/SleepReportEnvelope"},
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false}
    }
  ]
}
