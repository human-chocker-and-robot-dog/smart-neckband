# Volcengine V3 credentials. Keep the real file outside Git or in an ignored path.
VOLCENGINE_APPID=<app-key>
VOLCENGINE_TOKEN=<access-key>
VOLCENGINE_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_VOICE=<authorized-speaker-id>

# Optional identity and endpoint overrides.
VOLCENGINE_TTS_UID=smart-neckband-a-process
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional

# Ubuntu ALSA output. "default" follows the OS-selected output, including the
# default 3.5 mm headphone jack. Use `aplay -L` to choose another PCM name.
VOLCENGINE_TTS_AUDIO_DEVICE=default
VOLCENGINE_TTS_VOLUME=80
VOLCENGINE_TTS_SAMPLE_RATE=24000
VOLCENGINE_TTS_SPEECH_RATE=0
VOLCENGINE_TTS_PITCH_RATIO=0
VOLCENGINE_TTS_LOUDNESS_RATIO=0

# Latency/reliability tuning.
VOLCENGINE_TTS_QUEUE_SIZE=8
VOLCENGINE_TTS_REQUEST_TIMEOUT_S=20
VOLCENGINE_TTS_ALSA_BUFFER_TIME_US=100000
VOLCENGINE_TTS_ALSA_PERIOD_TIME_US=20000
