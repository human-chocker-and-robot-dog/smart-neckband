# Server-side only. Generate a long random value, for example:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Redis Marketplace integration. Prefer a TCP Redis URL usable by ioredis and Pub/Sub.
REDIS_URL=
# Supported when Vercel Marketplace injects a custom prefix.
live_heartbeat_REDIS_URL=

# Public fixed /live room. Viewer token is public to /live; ingest token must remain private.
LIVE_SESSION_ID=
LIVE_INGEST_TOKEN=
LIVE_VIEWER_TOKEN=

# Windows main-GUI Dashboard relay. Configure LIVE_WS_URL together with the
# same fixed LIVE_SESSION_ID and private LIVE_INGEST_TOKEN above. The relay
# reuses the GUI's existing BLE/UART acquisition and never opens a second port.
LIVE_WS_URL=wss://your-vercel-domain.example/api/ws
SMART_COLLAR_DASHBOARD_PUBLIC_URL=https://your-vercel-domain.example/dashboard

# Optional public base URL override used by POST /api/session to construct viewer_url.
# When omitted on Vercel, the API derives the public origin from forwarded request headers.
PUBLIC_BASE_URL=https://your-vercel-domain.example

# Optional tuning.
SESSION_TTL_SECONDS=43200
SESSION_CREATE_LIMIT_PER_MINUTE=10
WS_UPGRADE_LIMIT_PER_MINUTE=60
WS_MAX_DURATION_SECONDS=280

# PC-side Health MCP. These values are read by the Windows PC process and the
# stdio MCP child; do not expose them to the public Live Web frontend.
# Wearer ID must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}; do not use a real name.
SMART_COLLAR_WEARER_ID=<stable-non-name-id>
SMART_COLLAR_HEALTH_DB_PATH=data/health/health_state.db

# Optional local alert-rule file. Copy config/health_rules.example.json to an
# ignored local path, enable the required rules, and set this path.
SMART_COLLAR_HEALTH_RULES_PATH=data/health/health_rules.json

# Hackathon trusted-LAN Streamable HTTP MCP. The CPE private network is the
# access boundary; there is no application-level MCP authentication. Never
# expose this port directly to the public Internet. With SMART_COLLAR_WEARER_ID
# set, the main pc-gui automatically starts Health data and the MCP child.
SMART_COLLAR_HEALTH_MCP_HOST=0.0.0.0
SMART_COLLAR_HEALTH_MCP_PORT=8765
SMART_COLLAR_HEALTH_MCP_PATH=/mcp

# Optional independent health-event webhook. Configure all three together or
# leave all three unset. The secret is exactly 32 random bytes encoded as 64
# lowercase hex characters.
SMART_COLLAR_HEALTH_WEBHOOK_URL=http://127.0.0.1:8766/v1/health-events
SMART_COLLAR_HEALTH_WEBHOOK_KEY_ID=<health-key-id>
SMART_COLLAR_HEALTH_WEBHOOK_SECRET_HEX=<64-lowercase-hex>
